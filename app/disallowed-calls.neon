# Documentation: https://github.com/spaze/phpstan-disallowed-calls/blob/main/docs/custom-rules.md
parameters:

    disallowedNamespaces:
        -   # Core Domain should NEVER depend on laravel.
            namespace:
                - 'Illuminate\*'
            message: 'it is FORBIDDEN TO USE LARAVEL inside the core domain. Create a Port instead.'
            exclude:
                - 'Illuminate\Database\ConnectionInterface'

            allowExceptIn:
                - src/*

        -   # We do not want to use Facades. -> Dependency Injection
            namespace: 'Illuminate\Support\Facades\*'
            message: 'it is forbidden to use laravel facades (except in Providers) as it breaks encapsulation. Use dependency injection instead.'
            exclude:
                - 'Illuminate\Support\Facades\Hash'
                - 'Illuminate\Support\Facades\Validator'
            allowIn:
                - app/Providers/*

        -   # We do not want to use Facades. -> Dependency Injection
            namespace: 'Illuminate\Support\Facades\Validator'
            message: 'it is forbidden to use laravel facades (except in Providers) as it breaks encapsulation. Use dependency injection instead.'
            allowIn:
                - app/Http/Controllers/*

        -   # Definitions should not depend on CoreGameLogic
            namespace:
                - 'Domain\CoreGameLogic\*'
            message: 'it is FORBIDDEN TO USE CoreGameLogic inside Definitions.'

            allowExceptIn:
                - src/Definitions/*

    disallowedMethodCalls:
         -
            method: '*ForTesting*()'
            message: '..forTesting() only allowed in testcases.'

         -  # We always want to use GameUi::handleCommand() which also updates the gameEvents
            method: 'Domain\CoreGameLogic\DrivingPorts\ForCoreGameLogic::handle()'
            message: 'use GameUi::handleCommand() instead'
            allowExceptIn:
                - app/Livewire/Traits/*

         -  # Game actions are always triggered via their command, so the command handler stays the single entry point.
            # The UI may use Aktion::validate() (e.g. to enable buttons), but never execute().
            method: 'Domain\CoreGameLogic\Feature\Spielzug\Aktion\*::execute()'
            message: 'only command handlers may execute an Aktion. To trigger another game action, pass its command to the command handler instead, e.g. new SpielzugCommandHandler()->handle(QuitJob::create($playerId), $gameEvents).'
            allowIn:
                - src/CoreGameLogic/Feature/*/*CommandHandler.php

    disallowedFunctionCalls:
        -   # We do not want to use helpers which access global state. -> Dependency Injection
            function:
                - 'app()'
                - 'auth()'
                - 'broadcast()'
                - 'cache()'
                - 'config()'
                - 'context()'
                - 'dispatch()'
                - 'dispatch_sync()'
                - 'env()'
                - 'event()'
                - 'info()' # TODO: this might be OK
                #- 'logger()' is allowed
                - 'policy()'
                - 'request()'
                - 'resolve()'
                - 'session()'
                # 'view()' is allowed
            message: 'it is forbidden use global laravel functions which access global state. Use dependency injection instead.'
            allowIn:
                - 'app/Providers/*'

